*.iml
*.iws
*.ipr

# IDE - Vim / Emacs
*.swp
*.swo
*~
.*.swp
.*.swo

# Environment variables (包含敏感信息)
.env
.env.local
.env.*.local
.env.production
.env.development

# 保留示例文件
!.env.example

# Database (SQLite) & Data Directory
*.db
*.db-*
*.sqlite
*.sqlite3
*.db-journal
data/*
!data/.gitkeep

# Sensitive local scripts and internal docs
deploy.sh
reset_pwd.py
docs/

