# VPN Manager Configuration

# Admin credentials for web UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret key for session/JWT
SECRET_KEY=your-secret-key-change-this

# Docker container name
VPN_CONTAINER_NAME=ipsec-vpn-server

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/vpnmgr.db

# Server settings
HOST=0.0.0.0
PORT=8080
DEBUG=false

# VPN Environment file path (optional, for reading initial config)
VPN_ENV_FILE=/path/to/vpn.env


