# VPN Manager Configuration

# Admin credentials for web UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret key for session/JWT
SECRET_KEY=your-secret-key-change-this

# Docker container name
VPN_CONTAINER_NAME=ipsec-vpn-server

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/vpnmgr.db

# Server settings
HOST=0.0.0.0
PORT=8080
DEBUG=false

# VPN Environment file path (optional, for reading initial config)
VPN_ENV_FILE=/path/to/vpn.env

# VPN client subnet assigned by IKEv2 (Optional)
# Must match the subnet handed out by the VPN container. Used to insert the
# FORWARD allow-rule and to clean up legacy captive-portal rules on startup.
# VPN_SUBNET=192.168.43.0/24

# LAN health-check probe target (Optional)
# The public debug page uses this to verify that a VPN client can reach the
# internal network. Both values must be set to enable the check; leave
# LAN_CHECK_HOST empty to disable it and show "未配置内网探测目标" instead.
# LAN_CHECK_HOST=192.168.1.27
# LAN_CHECK_PORT=8081

# OIDC / SSO Configuration (Optional)
# OIDC_ENABLED=false
# OIDC_ISSUER_URL=https://sso.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://your-vpn-ip:8080/api/auth/sso/callback
# OIDC_SCOPES=openid profile email
# OIDC_PROVIDER_NAME=通过 SSO 单点登录
# OIDC_AUTO_CREATE_USER=true

# IKEv2 client config protection (Optional)
# When enabled, exported .p12 / .mobileconfig / .sswan files require an import
# password, so a leaked config file cannot be used without it.
# Can also be toggled per certificate in the web UI.
# PROTECT_CLIENT_CONFIG=false
# Fixed import password. Leave empty to auto-generate a random one.
# Allowed characters: letters, digits and . _ @ # % ^ * + = -
# CLIENT_CONFIG_PASSWORD=




